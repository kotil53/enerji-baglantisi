{
  "name": "enerji-baglantisi",
  "version": "1.0.0",
  "description": "Enerji Bağlantısı — kablo döndürme bulmacası (Capacitor paketi)",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:game": "node sync.mjs",
    "prepare:web": "node sync.mjs",
    "native:config": "node scripts/apply-native-config.mjs",
    "cap:sync": "node sync.mjs && cap sync && npm run native:config",
    "add:android": "node sync.mjs && cap add android && npm run native:config",
    "add:ios": "node sync.mjs && cap add ios && npm run native:config",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "assets": "capacitor-assets generate --iconBackgroundColor \"#0a0e1a\" --splashBackgroundColor \"#0a0e1a\"",
    "run:android": "node sync.mjs && cap run android",
    "run:ios": "node sync.mjs && cap run ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.0.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
